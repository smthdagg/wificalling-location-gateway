#!/bin/sh
# luci.wloc — rpcd exec plugin bridging LuCI to the wloc-service control plane.
#
# Protocol (rpcd exec plugin): `$0 list` prints the method table, `$0 call
# <method>` receives the JSON params on stdin. Every method is whitelisted
# below and every value passes as argv to /usr/sbin/wloc-ctl — never through
# a shell. The root-only daemon socket is never exposed to LuCI.

. /usr/share/libubox/jshn.sh

CTL=/usr/sbin/wloc-ctl
EXPORT=/usr/sbin/export-mobileconfig.sh

ctl_live() {
	out="$("$CTL" "$@" 2>&1)" && return 0
	# A pre-package hand deployment may leave an untracked process holding
	# port 8443 after its control socket dies.  Remove only this service's
	# process before handing lifecycle ownership back to procd.
	killall -q wloc-service >/dev/null 2>&1 || true
	rm -f /var/run/wloc-service/control.sock
	/etc/init.d/wloc-service restart >/dev/null 2>&1 || return 1
	retry=0
	while [ "$retry" -lt 10 ]; do
		sleep 1
		out="$("$CTL" "$@" 2>&1)" && return 0
		retry=$((retry + 1))
	done
	return 1
}

# The router's own LAN IPv4 for the CA profile URL: UCI is authoritative,
# the LAN bridge address is the fallback. Empty when not configured.
lan_ip() {
	ip=$(uci -q get network.lan.ipaddr) || ip=
	case "$ip" in
		''|*[!0-9.]*)
			ip=$(ip -4 addr show br-lan 2>/dev/null | sed -n 's/^[[:space:]]*inet \([0-9.]*\)\/.*/\1/p' | head -1)
			;;
	esac
	printf '%s' "$ip"
}

case "$1" in
list)
	json_init
	json_add_object ctl
	json_close_object
	json_add_object regen_profile
	json_close_object
	json_add_object cert_info
	json_close_object
	json_add_object regen_ca
	json_close_object
	json_add_object restart_service
	json_close_object
	json_add_object restart_gateway
	json_close_object
	json_add_object clear_log
	json_close_object
	json_add_object verify_fingerprint
	json_close_object
	json_add_object health
	json_close_object
	json_add_object node_test
	json_close_object
	json_dump
	json_cleanup
	;;
call)
	case "$2" in
	ctl)
		read -r input
		json_load "$input"
		json_get_var method method
		json_get_var query query
		json_get_var lat lat
		json_get_var lon lon

		case "$method" in
		status|reload|geo-clear|refresh)
			out="$("$CTL" "$method" 2>&1)"
			;;
		# enable AND disable both go through the self-healing path: with a
		# stale control socket the direct ctl call fails with a raw connect
		# error and the module can no longer be switched off from the UI.
		enable)
			ctl_live enable
			;;
		disable)
			ctl_live disable
			;;
		mode-set)
			case "$query" in
			auto)
				mode_method=geo-clear
				;;
			manual)
				if [ -z "$lat" ] || [ "$lat" = "null" ] \
				   || [ -z "$lon" ] || [ "$lon" = "null" ]; then
					echo '{"error":"manual mode requires latitude and longitude"}'
					exit 1
				fi
				mode_method=geo-set
				;;
			*)
				echo '{"error":"mode must be auto or manual"}'
				exit 1
				;;
			esac
			# Apply the location directly. Re-enabling an already intercepting
			# daemon returns invalid_config and prevents the mode change.
			# ctl_live already restarts the daemon if its socket is unavailable
			# and leaves the ctl output in the shared `out` variable. The
			# branch's last command must reflect the apply status: the original
			# `if [ $? ]` swallowed ctl failures and always reported success.
			if [ "$mode_method" = "geo-set" ]; then
				ctl_live geo-set --lat "$lat" --lon "$lon"
			else
				ctl_live geo-clear
			fi
			mode_rc=$?
			if [ "$mode_rc" -eq 0 ]; then
				if uci -q set "wloc-service.main.geo_source=$query" \
					&& { [ "$query" != "manual" ] \
						|| { uci -q set "wloc-service.main.manual_lat=$lat" \
							&& uci -q set "wloc-service.main.manual_lon=$lon"; }; } \
					&& uci -q commit wloc-service; then
					:
				else
					mode_rc=1
				fi
			fi
			[ "$mode_rc" -eq 0 ]
			;;
		geo-search)
			if [ -n "$query" ] && [ "$query" != "null" ]; then
				out="$("$CTL" geo-search --query "$query" 2>&1)"
			else
				echo '{"error":"geo-search 需要 --query 地名"}'
				exit 1
			fi
			;;
		geo-set)
			if [ -n "$query" ] && [ "$query" != "null" ]; then
				out="$("$CTL" geo-set --query "$query" 2>&1)"
			elif [ -n "$lat" ] && [ "$lat" != "null" ] \
			     && [ -n "$lon" ] && [ "$lon" != "null" ]; then
				out="$("$CTL" geo-set --lat "$lat" --lon "$lon" 2>&1)"
			else
				echo '{"error":"geo-set needs --query or --lat --lon"}'
				exit 1
			fi
			;;
		*)
			echo '{"error":"unknown control method"}'
			exit 1
			;;
		esac
		rc=$?
		if [ "$rc" -ne 0 ]; then
			json_init
			json_add_string error "$out"
			json_dump
			exit 1
		fi
		# The daemon reply is a framed JSON envelope; pass the result
		# object through unchanged. A non-envelope reply (plain text with
		# quotes/newlines) must still become valid JSON for the LuCI rpc
		# layer, so it goes through json_add_string instead of raw
		# interpolation.
		result="$(echo "$out" | jsonfilter -qe '@.result')"
		if [ -n "$result" ]; then
			echo "{\"result\":$result}"
		else
			json_init
			json_add_string result "$out"
			json_dump
		fi
		exit 0
		;;
	regen_profile)
		if [ ! -x "$EXPORT" ]; then
			json_init
			json_add_string error "export-mobileconfig.sh 未安装"
			json_dump
			exit 1
		fi
		out="$("$EXPORT" 2>&1)"
		if [ "$?" -ne 0 ]; then
			json_init
			json_add_string error "$out"
			json_dump
			exit 1
		fi
		json_init
		json_add_boolean ok 1
		ip=$(lan_ip)
		if [ -n "$ip" ]; then
			json_add_string url "http://$ip/wloc-ca.mobileconfig"
		else
			json_add_string url ""
		fi
		json_dump
		exit 0
		;;
	cert_info)
		if [ -f /etc/wloc-service/ca.info.json ]; then
			cat /etc/wloc-service/ca.info.json
		else
			echo '{"error":"CA 信息文件不存在，请先启动 wloc-service"}'
		fi
		exit 0
		;;
	verify_fingerprint)
		read -r input
		json_load "$input"
		json_get_var fingerprint fingerprint
		if [ -z "$fingerprint" ] || [ "$fingerprint" = "null" ]; then
			echo '{"error":"请粘贴 iPhone 上显示的证书指纹"}'
			exit 1
		fi
		if [ ! -f /etc/wloc-service/ca.info.json ]; then
			echo '{"error":"CA 信息文件不存在，请先启动 wloc-service"}'
			exit 1
		fi
		gw="$(jsonfilter -i /etc/wloc-service/ca.info.json -e '@.fingerprint')"
		# Strip every whitespace class (a pasted fingerprint can wrap lines)
		# plus the separators; build the reply with json_add_string so an
		# unexpected ca.info.json value can never produce invalid JSON.
		norm() { echo "$1" | tr -d '[:space:]' | tr -d ':' | tr '[:lower:]' '[:upper:]'; }
		if [ "$(norm "$fingerprint")" = "$(norm "$gw")" ]; then
			json_init
			json_add_boolean match 1
			json_add_string gateway_fingerprint "$gw"
			json_dump
		else
			json_init
			json_add_boolean match 0
			json_add_string gateway_fingerprint "$gw"
			json_dump
		fi
		exit 0
		;;
	restart_service)
		# Re-sync the redirect rules first (the followed device may have
		# changed), then restart the daemon so it reads the new config.
		/usr/sbin/wloc-redirect-sync.sh >/dev/null 2>&1 || true
		if ! /etc/init.d/wloc-service restart >/dev/null 2>&1; then
			echo '{"error":"wloc-service restart failed"}'
			exit 1
		fi
		sleep 2
		echo '{"ok":true}'
		exit 0
		;;
	restart_gateway)
		# Regenerate the sing-box config and restart the proxy for the
		# Wi-Fi Calling Gateway (brief interruption of device proxy).
		if ! /etc/init.d/wificalling-gateway restart >/dev/null 2>&1; then
			echo '{"error":"wificalling-gateway restart failed"}'
			exit 1
		fi
		sleep 2
		echo '{"ok":true}'
		exit 0
		;;
	health)
		if [ ! -x /usr/sbin/wloc-health.sh ]; then
			json_init
			json_add_string error "wloc-health.sh 未安装"
			json_dump
			exit 1
		fi
		/usr/sbin/wloc-health.sh
		exit 0
		;;
	clear_log)
		# Truncate a usage log immediately with a shell redirect (O_TRUNC).
		# The old path went through LuCI's fs.write ubus call, which could
		# stall while a monitor process holds the file open, leaving the
		# confirm modal open until the write returned.
		read -r input
		json_load "$input"
		json_get_var log log
		case "$log" in
			wfc) : > /var/run/wificalling-gateway/events.log ;;
			wloc) : > /var/run/wloc-service/events.jsonl ;;
			*) echo '{"error":"unknown log target"}'; exit 1 ;;
		esac
		echo '{"ok":true}'
		exit 0
		;;
	node_test)
		# Manual connection test for a single node. Every protocol uses the
		# existing Gateway sing-box loopback probe and bypasses the monitor cache.
		read -r input
		json_load "$input"
		json_get_var id id
		if [ -z "$id" ] || [ "$id" = "null" ]; then
			echo '{"state":"failed","reason":"no_node_id"}'
			exit 0
		fi
		if [ ! -x /usr/libexec/wificalling-gateway/node-test.sh ]; then
			echo '{"state":"failed","reason":"no_test_helper"}'
			exit 0
		fi
		/usr/libexec/wificalling-gateway/node-test.sh "$id"
		exit 0
		;;
	regen_ca)
		# Regenerate the root CA: move the persisted key/cert aside (restore
		# them if the daemon fails to produce a new CA, so the router is never
		# left with no CA at all), restart the daemon (procd respawns and
		# creates a fresh CA + info), then rewrite the iOS profile. The iPhone
		# must reinstall and re-trust the CA.
		ca_backup=/etc/wloc-service/ca.old.$$
		mkdir -p "$ca_backup"
		mv -f /etc/wloc-service/ca.pem /etc/wloc-service/ca.key /etc/wloc-service/ca.info.json "$ca_backup"/ 2>/dev/null || true
		/usr/sbin/wloc-redirect-sync.sh >/dev/null 2>&1 || true
		/etc/init.d/wloc-service restart >/dev/null 2>&1
		sleep 3
		if [ ! -f /etc/wloc-service/ca.info.json ]; then
			# Roll back so the previous CA keeps working; a router with no CA
			# at all cannot rebuild trust without manual reconstruction.
			mv -f "$ca_backup"/* /etc/wloc-service/ 2>/dev/null || true
			rmdir "$ca_backup" 2>/dev/null || true
			json_init
			json_add_string error "重新生成证书失败，请检查 wloc-service 状态"
			json_dump
			exit 1
		fi
		rm -rf "$ca_backup"
		if [ -x "$EXPORT" ]; then
			if ! "$EXPORT" >/dev/null 2>&1; then
				json_init
				json_add_string error "新 CA 已生成，但 iOS 描述文件导出失败；请手动点击\"重新生成描述文件\""
				json_dump
				exit 1
			fi
		fi
		cat /etc/wloc-service/ca.info.json
		exit 0
		;;
	esac
	;;
esac
