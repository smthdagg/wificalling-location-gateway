{
  "luci-app-wificalling-location-gateway": {
    "description": "Grant access to the Wi-Fi Calling & WLOC location gateway admin pages",
    "read": {
      "ubus": {
        "luci.wloc": [
          "ctl",
          "regen_profile",
          "cert_info",
          "regen_ca",
          "restart_service",
          "verify_fingerprint",
          "health",
          "restart_gateway",
          "node_test",
          "update_status"
        ],
        "file": [
          "read"
        ]
      },
      "uci": [
        "wloc-service"
      ],
      "file": {
        "/var/run/wloc-service/status.json": [
          "read"
        ],
        "/var/run/wloc-service/events.jsonl": [
          "read"
        ],
        "/var/run/wloc-service/profiles/*/status.json": [
          "read"
        ],
        "/var/run/wloc-service/profiles/*/events.jsonl": [
          "read"
        ],
        "/tmp/run/wloc-service/status.json": [
          "read"
        ],
        "/tmp/run/wloc-service/events.jsonl": [
          "read"
        ]
      }
    },
    "write": {
      "ubus": {
        "luci.wloc": [
          "ctl",
          "regen_profile",
          "cert_info",
          "regen_ca",
          "restart_service",
          "restart_unified",
          "support_bundle",
          "verify_fingerprint",
          "node_test",
          "restart_gateway",
          "clear_log",
          "update_preflight",
          "update_apply",
          "update_recover"
        ],
        "file": [
          "write"
        ]
      },
      "uci": [
        "wloc-service"
      ],
      "file": {
        "/var/run/wloc-service/events.jsonl": [
          "write"
        ],
        "/var/run/wloc-service/profiles/*/events.jsonl": [
          "write"
        ],
        "/tmp/run/wloc-service/events.jsonl": [
          "write"
        ]
      }
    }
  }
}
