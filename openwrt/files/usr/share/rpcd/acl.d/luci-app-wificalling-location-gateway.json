{
  "luci-app-wificalling-location-gateway": {
    "description": "Grant access to the unified Wi-Fi Calling Gateway and WLOC admin pages",
    "read": {
      "ubus": {
        "luci.wloc": [
          "cert_info",
          "verify_fingerprint",
          "health",
          "provider_test",
          "update_status",
          "node_test"
        ],
        "file": [
          "read"
        ]
      },
      "uci": [
        "wloc-service",
        "wificalling-gateway",
        "dhcp"
      ],
      "file": {
        "/var/run/wloc-service/status.json": [
          "read"
        ],
        "/var/run/wloc-service/events.jsonl": [
          "read"
        ],
        "/var/run/wloc-service/profiles/*/status.json": [
          "read"
        ],
        "/var/run/wloc-service/profiles/*/events.jsonl": [
          "read"
        ],
        "/tmp/run/wloc-service/status.json": [
          "read"
        ],
        "/tmp/run/wloc-service/events.jsonl": [
          "read"
        ],
        "/var/run/wificalling-gateway/status.json": [
          "read"
        ],
        "/var/run/wificalling-gateway/node-status.json": [
          "read"
        ],
        "/var/run/wificalling-gateway/events.log": [
          "read"
        ],
        "/tmp/run/wificalling-gateway/status.json": [
          "read"
        ],
        "/tmp/run/wificalling-gateway/node-status.json": [
          "read"
        ],
        "/tmp/run/wificalling-gateway/events.log": [
          "read"
        ]
      }
    },
    "write": {
      "ubus": {
        "luci.wloc": [
          "ctl",
          "regen_profile",
          "regen_ca",
          "restart_service",
          "restart_unified",
          "support_bundle",
          "verify_fingerprint",
          "clear_log",
          "update_preflight",
          "update_apply",
          "update_recover",
          "restart_gateway",
          "node_test"
        ],
        "file": [
          "write"
        ]
      },
      "uci": [
        "wloc-service",
        "wificalling-gateway"
      ],
      "file": {
        "/var/run/wloc-service/events.jsonl": [
          "write"
        ],
        "/var/run/wloc-service/profiles/*/events.jsonl": [
          "write"
        ],
        "/tmp/run/wloc-service/events.jsonl": [
          "write"
        ]
      }
    }
  }
}
