#!/bin/sh /etc/rc.common
# WLOC service control daemon
#
# Serves the frozen wloc.service/v1 control API on a root-only Unix socket.
# The socket directory is root-owned mode 0700; the socket itself is mode
# 0600 (set by the daemon). No TCP listener is ever opened.

USE_PROCD=1
START=95
STOP=10

SOCKET_DIR=/var/run/wloc-service
SOCKET="$SOCKET_DIR/control.sock"
SINGBOX_RUNTIME_HELPER=${WLOC_PROVIDER_HELPER:-/usr/libexec/wificalling-location-gateway/singbox-runtime.sh}

start_service() {
	mkdir -p "$SOCKET_DIR" /etc/wloc-service
	chmod 0700 "$SOCKET_DIR"
	SINGBOX_BIN=$("$SINGBOX_RUNTIME_HELPER" path 2>/dev/null) || SINGBOX_BIN=
	SINGBOX_CONFIG=$(uci -q get wloc-service.main.singbox_config 2>/dev/null || true)
	[ -n "$SINGBOX_CONFIG" ] || SINGBOX_CONFIG=/var/run/wloc-service/sing-box.json

	procd_open_instance
	procd_set_param command /usr/sbin/wloc-service
	procd_set_param env "WLOC_SOCKET=$SOCKET" \
		"WLOC_CA_CERT=/etc/wloc-service/ca.pem" \
		"WLOC_CA_KEY=/etc/wloc-service/ca.key" \
		"WLOC_PROXY_PORT=8443" \
		"WLOC_SINGBOX_CONFIG=$SINGBOX_CONFIG" \
		"WLOC_SUPERVISED=${WLOC_SUPERVISED:-0}" \
		"WLOC_DEFER_REDIRECT=${WLOC_DEFER_REDIRECT:-0}" \
		"WLOC_SINGBOX_BIN=$SINGBOX_BIN"
	if [ "${WLOC_SUPERVISED:-0}" != 1 ]; then
		procd_set_param respawn
	fi
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	# Keep the nftables redirect in sync with standalone WLOC device profiles.
	# The unified supervisor owns this step and installs the redirect only
	# after both children pass health checks. Legacy standalone startup keeps
	# the old behavior for rollback compatibility.
	if [ "${WLOC_SKIP_REDIRECT:-0}" != 1 ]; then
		/usr/sbin/wloc-redirect-sync.sh >/dev/null 2>&1 || true
	fi
}

stop_service() {
	rm -f "$SOCKET"
	[ -x /usr/sbin/wloc-profile-redirect.sh ] && \
		/usr/sbin/wloc-profile-redirect.sh stop-all >/dev/null 2>&1 || true
}
