#!/bin/sh /etc/rc.common
# WLOC service control daemon
#
# Serves the frozen wloc.service/v1 control API on a root-only Unix socket.
# The socket directory is root-owned mode 0700; the socket itself is mode
# 0600 (set by the daemon). No TCP listener is ever opened.

USE_PROCD=1
START=95
STOP=10

SOCKET_DIR=/var/run/wloc-service
SOCKET="$SOCKET_DIR/control.sock"

start_service() {
	mkdir -p "$SOCKET_DIR" /etc/wloc-service
	chmod 0700 "$SOCKET_DIR"

	procd_open_instance
	procd_set_param command /usr/sbin/wloc-service
	procd_set_param env "WLOC_SOCKET=$SOCKET" \
		"WLOC_CA_CERT=/etc/wloc-service/ca.pem" \
		"WLOC_CA_KEY=/etc/wloc-service/ca.key" \
		"WLOC_PROXY_PORT=8443"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	# Keep the nftables redirect in sync with the gateway device policies.
	/usr/sbin/wloc-redirect-sync.sh >/dev/null 2>&1 || true
}

stop_service() {
	rm -f "$SOCKET"
}
