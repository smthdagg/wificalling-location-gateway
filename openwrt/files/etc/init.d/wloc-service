#!/bin/sh /etc/rc.common
# WLOC service control daemon
#
# Serves the frozen wloc.service/v1 control API on a root-only Unix socket.
# The socket directory is root-owned mode 0700; the socket itself is mode
# 0600 (set by the daemon). No TCP listener is ever opened.

USE_PROCD=1
# Start after the Gateway's sing-box (START=99); WLOC auto mode probes the
# already-running node path during daemon startup.
START=100
STOP=10

SOCKET_DIR=/var/run/wloc-service
SOCKET="$SOCKET_DIR/control.sock"

start_service() {
	mkdir -p "$SOCKET_DIR" /etc/wloc-service
	chmod 0700 "$SOCKET_DIR"

	# The daemon always starts (the control API backs the LuCI page and the
	# enable toggle); only interception-side state is conditional. With WLOC
	# disabled, withdraw every leftover (DNS hijack, TPROXY, upstream map) so
	# disabled means genuinely fail-open pass-through.
	local enabled
	enabled=$(uci -q get wloc-service.main.enabled 2>/dev/null || echo 1)
	if [ "$enabled" != "1" ]; then
		/usr/sbin/wloc-redirect-sync.sh stop >/dev/null 2>&1 || true
		procd_open_instance
		procd_set_param command /usr/sbin/wloc-service
		procd_set_param env "WLOC_SOCKET=$SOCKET" \
			"WLOC_CA_CERT=/etc/wloc-service/ca.pem" \
			"WLOC_CA_KEY=/etc/wloc-service/ca.key" \
			"WLOC_PROXY_PORT=8443"
		procd_set_param respawn
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
		return 0
	fi

	# Validate the device scope and destination set before interception. A
	# clean install has neither yet: keep the daemon/control socket alive in
	# pass-through mode so LuCI can configure the service without an Agent-side
	# repair. The daemon itself still refuses to install the redirect.
	scope_ready=1
	if ! /usr/sbin/wloc-redirect-sync.sh prepare >/dev/null 2>&1; then
		logger -t wloc-service "scope not ready; keeping daemon in pass-through mode (device scope invalid)"
		scope_ready=0
	fi
	if [ "$scope_ready" -eq 1 ] && ! /usr/sbin/wloc-refresh-set.sh >/dev/null 2>&1; then
		logger -t wloc-service "scope not ready; keeping daemon in pass-through mode (Apple destination set unavailable)"
		scope_ready=0
	fi
	if [ "$scope_ready" -eq 0 ]; then
		/usr/sbin/wloc-redirect-sync.sh stop >/dev/null 2>&1 || true
	fi

	procd_open_instance
	procd_set_param command /usr/sbin/wloc-service
	procd_set_param env "WLOC_SOCKET=$SOCKET" \
		"WLOC_CA_CERT=/etc/wloc-service/ca.pem" \
		"WLOC_CA_KEY=/etc/wloc-service/ca.key" \
		"WLOC_PROXY_PORT=8443"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

}

stop_service() {
	/usr/sbin/wloc-redirect-sync.sh stop >/dev/null 2>&1 || true
	rm -f "$SOCKET"
}

reload_service() { restart; }

service_triggers() { procd_add_reload_trigger wloc-service wificalling-gateway; }
