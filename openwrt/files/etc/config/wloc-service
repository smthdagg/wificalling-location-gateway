# WLOC service configuration
#
# The control daemon serves the frozen wloc.service/v1 API on a root-only
# Unix socket. Options here are read once at daemon startup:
#   enabled          module on/off (also runtime control.enable/disable)
#   geo_source       auto (follow the bound node exit) | manual (fixed preset)
#   manual_lat/lon   coordinates used when geo_source=manual
#   node_ref         sing-box node tag to follow (auto mode)
#   assigned_device  LAN IP of the test device whose node binding is probed
#   probe_interval   max age of a probe observation before re-probing (seconds)
#   geo_provider     http (ip-api.com) | stub (deterministic, for staging)
#   probe_port       local HTTP proxy port used to observe the exit IP
#
# Presets below are saved manual locations managed from LuCI; selecting one
# copies its coordinates into manual_lat/manual_lon and sets geo_source.

config wloc-service 'main'
	option enabled '1'
	option geo_source 'auto'
	option manual_lat '51.5074'
	option manual_lon '-0.1278'
	option node_ref 'default'
	# assigned_device is chosen from LuCI (WLOC Settings > Follow device);
	# when unset the daemon follows the first device policy of the
	# wificalling-gateway config instead of any fixed example address.
	option probe_interval '300'
	option geo_provider 'http'
	option probe_port '18080'

config preset 'london'
	option label 'London'
	option latitude '51.5074'
	option longitude '-0.1278'

config preset 'hong_kong'
	option label 'Hong Kong'
	option latitude '22.3193'
	option longitude '114.1694'

